  m_Script: {fileID: 11500000, guid: 83247556cd9812348ac697461be1605d, type: 3}
  m_Name: NPC-CG
  m_EditorClassIdentifier: 
  IsAMonologue: 0
  IsACassette: 0
  lines:
  - npcType: 6
    dialogueText: Excuse me. You look familiar.
  - npcType: 6
    dialogueText: Aren't you the photographer from that newspaper...
  - npcType: 2
    dialogueText: Y-yes! That's me! I didn't think anyone would recognize me!
  - npcType: 6
    dialogueText: What are you doing on this train?
  - npcType: 2
    dialogueText: Chasing a big shot. Something real. Something unforgettable.
  - npcType: 2
    dialogueText: Sometimes I even think about doing something reckless.
  - npcType: 2
    dialogueText: Like pulling the train's emergency button... just to see what happens.
  - npcType: 2
    dialogueText: N-not that I would! Probably...
  hasPostMonologue: 1
  postMonologueEvent: 70
