  IsAMonologue: 0
  lines:
  - npcType: 2
    dialogueText: Okay... camera, check. Photo of mysterious handsome stranger, double
      check!
  - npcType: 2
    dialogueText: Never having the guts to ask for his number... triple check!
  - npcType: 6
    dialogueText: Are you a photographer?
  - npcType: 2
    dialogueText: Wahh!! Oh my god!! You almost gave me a heart attack!
  - npcType: 2
    dialogueText: Where did you... Never mind. Yes! I work for a well-known newspaper.
  - npcType: 6
    dialogueText: Oh, that's pretty cool. I also like...
  - npcType: 2
    dialogueText: Sorry to interrupt! I'm kind of busy. I've got a phone... I mean,
      a photo to ask for. Have a nice day!
  hasPostMonologue: 1
  postMonologueEvent: 59
