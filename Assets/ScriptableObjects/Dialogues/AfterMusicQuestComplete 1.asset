  m_Script: {fileID: 11500000, guid: 83247556cd9812348ac697461be1605d, type: 3}
  m_Name: AfterMusicQuestComplete 1
  m_EditorClassIdentifier: 
  IsAMonologue: 1
  IsACassette: 0
  lines:
  - npcType: 6
    dialogueText: Why does it hurt so much?
  - npcType: 6
    dialogueText: I feel like I've lost something very important... again.
  - npcType: 6
    dialogueText: Guilt and sadness are filling my whole body.
  - npcType: 6
    dialogueText: I knew her. I lived with her.
  - npcType: 6
    dialogueText: I hated her. I loved her...
  - npcType: 6
    dialogueText: She was like a sister to me...
  - npcType: 6
    dialogueText: My head hurts.
  - npcType: 6
    dialogueText: I should keep going. I feel closer to the truth than ever.
  hasPostMonologue: 0
  postMonologueEvent: 0
