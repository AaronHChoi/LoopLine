  IsAMonologue: 1
  IsACassette: 1
  lines:
  - npcType: 5
    dialogueText: Umh... February 15.
  - npcType: 5
    dialogueText: I feel so stupid doing this.
  - npcType: 5
    dialogueText: Okay, no. This is supposed to be progress.
  - npcType: 5
    dialogueText: Trying to be... a better person. Ugh.
  - npcType: 5
    dialogueText: I saw her using one of these for work. Thought I'd try it too.
  - npcType: 5
    dialogueText: I'm not that smart, but I'll start with these books.
  - npcType: 5
    dialogueText: Maybe they'll be the key to getting somewhere.
  - npcType: 5
    dialogueText: I hope...
  hasPostMonologue: 0
  postMonologueEvent: 0
