  m_Script: {fileID: 11500000, guid: 83247556cd9812348ac697461be1605d, type: 3}
  m_Name: Cassette2
  m_EditorClassIdentifier: 
  IsAMonologue: 1
  IsACassette: 1
  lines:
  - npcType: 5
    dialogueText: March 24.
  - npcType: 5
    dialogueText: Today I got the final warning. If I don't pay, I'll lose this place
      for good.
  - npcType: 5
    dialogueText: I hate myself for even considering this, but I think I'm going
      to sign the confidentiality contract.
  - npcType: 5
    dialogueText: It's unfair to you and your family... especially to her.
  - npcType: 5
    dialogueText: But there's nothing I can do to change what happened.
  - npcType: 5
    dialogueText: Maybe I'm selfish, but this place carries my parents' history.
      Our history... the three of us... I can't let it disappear.
  - npcType: 5
    dialogueText: Remember those vinyl records? Of course you do. You gave me some
      so I could sell them at the store.
  - npcType: 5
    dialogueText: I knew they were used. I also knew how hard it must've been for
      you to get them.
  - npcType: 5
    dialogueText: I wasn't mad because they were secondhand. I was mad because I
      knew how much you'd sacrificed for me.
  - npcType: 5
    dialogueText: You always saw my real face. The better one.
  - npcType: 5
    dialogueText: I know it's too late now, but... thank you.
  - npcType: 5
    dialogueText: ...
  hasPostMonologue: 0
  postMonologueEvent: 0
