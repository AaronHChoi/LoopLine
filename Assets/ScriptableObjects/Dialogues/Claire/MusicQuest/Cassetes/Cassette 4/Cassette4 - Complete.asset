  m_Script: {fileID: 11500000, guid: 83247556cd9812348ac697461be1605d, type: 3}
  m_Name: Cassette4 - Complete
  m_EditorClassIdentifier: 
  IsAMonologue: 1
  IsACassette: 1
  lines:
  - npcType: 5
    dialogueText: August 6.
  - npcType: 5
    dialogueText: ' I finally made up my mind.'
  - npcType: 5
    dialogueText: I paid for this place and I still had enough left to get professional
      advice.
  - npcType: 5
    dialogueText: I'm planning to leave everything to her. Even if we haven't spoken
      since I signed.
  - npcType: 5
    dialogueText: And what am I going to do next? You won't believe it...
  - npcType: 5
    dialogueText: I'm going after the working man. With my new lawyer.
  - npcType: 5
    dialogueText: I'll bring the evidence. I'll tell what really happened that day.
  - npcType: 5
    dialogueText: Yeah. I'm doing it. I don't care what happens to me anymore.
  - npcType: 5
    dialogueText: I just hope she listens to these cassettes. So she can know who
      I really am.
  - npcType: 5
    dialogueText: Hey, you! If you're hearing this... you and your brother were my
      family.
  - npcType: 5
    dialogueText: I left you the money and the papers in the safe. I know you're
      smart enough to figure out the code.
  - npcType: 5
    dialogueText: The cassettes...
  - npcType: 5
    dialogueText: Oh, speaking of the devil. Hey... why are you carrying a kni...
  - npcType: 5
    dialogueText: Oh, speaking of the devil. Hey... why are you carrying a kni...
  - npcType: 5
    dialogueText: 'Uhg... uhgg... '
  - npcType: 5
    dialogueText: Forgive... me... Cla...
  - npcType: 6
    dialogueText: ...
  - npcType: 6
    dialogueText: ...
  hasPostMonologue: 0
  postMonologueEvent: 0
