  m_Script: {fileID: 11500000, guid: 83247556cd9812348ac697461be1605d, type: 3}
  m_Name: Cassette3
  m_EditorClassIdentifier: 
  IsAMonologue: 1
  IsACassette: 1
  lines:
  - npcType: 5
    dialogueText: April 2...
  - npcType: 5
    dialogueText: I was doing better, but... I think my joke yesterday got out of
      hand.
  - npcType: 5
    dialogueText: ' I gotta be less impulsive.'
  - npcType: 5
    dialogueText: Except when I go to my favourite recitals. Hell yeah!
  - npcType: 5
    dialogueText: Ahem. Anyway... these posters mean everything to me.
  - npcType: 5
    dialogueText: The're not just proof that I was there.
  - npcType: 5
    dialogueText: The're are memories of the nights we shared. The good ones. The
      ones I don't want to lose.
  - npcType: 5
    dialogueText: I miss you... even if I stayed silent...
  - npcType: 5
    dialogueText: I should be kinder to Claire. She hates me... and she has every
      reason to.
  - npcType: 5
    dialogueText: Anyway, I'll go to a new recital and I'll get a new poster for
      us.
  - npcType: 5
    dialogueText: I promise...
  hasPostMonologue: 0
  postMonologueEvent: 0
