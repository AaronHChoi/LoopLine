  lines:
  - npcType: 4
    dialogueText: I need to stop the train. I need to get off this goddamn train!
  - npcType: 6
    dialogueText: Hey, tell me what's happening here. Let me help you!
  - npcType: 4
    dialogueText: Help? You can't help me! Not after what I did...
  - npcType: 4
